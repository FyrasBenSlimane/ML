<IfModule mod_rewrite.c>
    RewriteEngine On
    # Pas de RewriteBase : rewrite relatif → fonctionne à la racine
    # comme dans un sous-dossier XAMPP (htdocs/Projet ML/...).

    # Ne pas réécrire les fichiers/dossiers existants (assets, images...)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Tout le reste est redirigé vers le front controller
    RewriteRule ^(.+)$ index.php?url=$1 [QSA,L]
</IfModule>
