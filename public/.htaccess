<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Ne pas réécrire les fichiers/dossiers existants (assets, images...)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Tout le reste est redirigé vers le front controller
    RewriteRule ^(.+)$ index.php?url=$1 [QSA,L]
</IfModule>
